{
  "name": "hackmitten-3.0",
  "private": true,
  "version": "3.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "install:all": "bun install",
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "cd frontend && bun run dev",
    "dev:backend": "cd backend && bun run dev",
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "cd frontend && bun run build",
    "build:backend": "cd backend && bun run build",
    "test": "bun test backend/tests tests/integration",
    "lint": "cd frontend && bun run lint && cd ../backend && bun run lint",
    "typecheck": "cd frontend && bun run typecheck && cd ../backend && bun run typecheck && cd ../shared && bun run typecheck",
    "db:validate": "cd backend && bun run db:validate",
    "db:generate": "cd backend && bun run db:generate",
    "db:migrate:deploy": "cd backend && bun run db:migrate:deploy",
    "db:bootstrap": "cd backend && bun run db:bootstrap"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

{
  "name": "hackmitten-backend",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "build": "prisma generate && next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:bootstrap": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "3.0.3",
    "next": "16.1.3",
    "next-auth": "4.24.13",
    "nodemailer": "10.0.10",
    "prisma": "6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.5",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "bun-types": "1.3.6",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2"
}

NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3001

# PostgreSQL runtime and migration connection strings
DATABASE_URL=
DIRECT_URL=

# Canonical public origin, used in links and session security
NEXTAUTH_URL=https://<public-frontend-domain>
NEXTAUTH_SECRET=

# Comma-separated exact origins. Production uses the same-origin proxy.
BACKEND_CORS_ORIGINS=https://<public-frontend-domain>,http://localhost:3000

# Private persistent storage; not web served
HACKMITTEN_STORAGE_ROOT=/var/lib/hackmitten

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required only for explicitly authorized bootstrap/reset workflows
HM3_BERSERK_SECRET=

# Operational account identifiers; supply private real values for initial bootstrap
HM3_SUPER_ADMIN_USERNAME=hackmittenadmin2026
HM3_SUPER_ADMIN_EMAIL=
HM3_SUPER_ADMIN_PASSWORD=
HM3_COORDINATOR_USERNAME=hackmitten2026
HM3_COORDINATOR_EMAIL=
HM3_COORDINATOR_PASSWORD=
HM3_FOOD_ADMIN_USERNAME=hackmittenfood2026
HM3_FOOD_ADMIN_EMAIL=
HM3_FOOD_ADMIN_PASSWORD=

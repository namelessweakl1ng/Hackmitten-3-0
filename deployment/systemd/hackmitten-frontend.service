[Unit]
Description=Hackmitten 3.0 frontend
After=network-online.target hackmitten-backend.service
Wants=network-online.target

[Service]
Type=simple
User=hackmitten-web
Group=hackmitten-web
WorkingDirectory=/opt/hackmitten/frontend/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/hackmitten/frontend/current/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target

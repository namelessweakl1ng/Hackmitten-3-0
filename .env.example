# Environment variables
# Supply values at runtime via a protected environment file or secret manager.
# Do not use these placeholders as credentials.

# Required for application runtime and Prisma
DATABASE_URL=
DIRECT_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Required only when running bun run db:bootstrap (initial setup / credential rotation)
ADMIN_USERNAME=hackmittenadmin2026
ADMIN_EMAIL=
ADMIN_PASSWORD=
HM3_BERSERK_SECRET=

# Required bootstrap role accounts; supply real emails and unique passwords in the protected runtime env file
COORDINATOR_USERNAME=hackmitten2026
COORDINATOR_EMAIL=
COORDINATOR_PASSWORD=
FOOD_ADMIN_USERNAME=hackmittenfood2026
FOOD_ADMIN_EMAIL=
FOOD_ADMIN_PASSWORD=

# SMTP email (required for registration notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Persistent Linux filesystem root; recommended production value: /var/lib/hackmitten.
# Storage is split into public/ and private/ below this root.
HACKMITTEN_STORAGE_ROOT=
# Optional overrides; normally leave blank.
# Mount these outside the release directory and make them writable by the service account.
HM3_PUBLIC_UPLOAD_DIR=
HM3_PRIVATE_UPLOAD_DIR=

[Unit]
Description=Hackmitten 3.0 application
After=network.target

[Service]
Type=simple
User=hackmitten
Group=hackmitten
WorkingDirectory=/opt/hackmitten/current
EnvironmentFile=/etc/hackmitten/hackmitten.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/hackmitten/current/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hackmitten

[Install]
WantedBy=multi-user.target

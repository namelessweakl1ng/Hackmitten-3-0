// Hackmitten 3.0 — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & ROLES
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  COORDINATOR
  FOOD_ADMIN
  PARTICIPANT
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(PARTICIPANT)
  // BERSERK recovery hash (argon2/bcrypt of the recovery secret). NULL for non-super-admins.
  recoveryHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs          AuditLog[]
  foodCheckIns       FoodCheckIn[]
  verifiedPayments   Payment[]
  changeHistory      ChangeHistory[]     @relation("ChangeHistoryChangedBy")
  rolledBackChanges  ChangeHistory[]     @relation("ChangeHistoryRolledBackBy")
  coordinatorProfile CoordinatorProfile?

  @@index([role])
  @@index([username])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT CONFIGURATION — single-row table (extensively expanded)
// ─────────────────────────────────────────────────────────────────────────────

model EventConfig {
  id String @id @default("singleton")

  // Basics
  eventName   String @default("Hackmitten 3.0")
  edition     String @default("3.0")
  tagline     String @default("IDEAS BEYOND THE HORIZON")
  description String @default("24 hours. Real problems. Limitless possibilities.")

  // Event timing (ISO date strings + HH:mm time + IANA timezone)
  eventStartDate     String @default("")
  eventStartTime     String @default("09:00")
  eventEndDate       String @default("")
  eventEndTime       String @default("09:00")
  eventTimezone      String @default("Asia/Kolkata")
  eventDurationHours Int    @default(24)

  // Registration
  registrationDeadline String  @default("") // ISO datetime string
  registrationFee      String  @default("₹1,000")
  prizePool            String  @default("₹1,00,000")
  // Registration capacity & manual open/close toggle
  registrationCapacity Int     @default(60)
  registrationsOpen    Boolean @default(true)

  // Hero
  heroHeading     String  @default("HACKMITTEN")
  heroEdition     String  @default("3.0")
  heroSubtitle    String  @default("IDEAS BEYOND THE HORIZON")
  heroDescription String  @default("24 hours. Real problems. Limitless possibilities.")
  heroCtaText     String  @default("REGISTER NOW")
  heroCtaLink     String  @default("/register")
  heroVisible     Boolean @default(true)

  // About
  aboutHeading      String @default("BUILD. BREAK. REBUILD.")
  aboutDescription  String @default("Hackmitten is not a hackathon. It is a descent into the unknown — a place where ideas cross the event horizon and emerge as something built, broken, and rebuilt into existence.")
  aboutStatDuration String @default("24")
  aboutStatTeamSize String @default("3—4")
  aboutStatFee      String @default("₹1,000")
  aboutStatPrize    String @default("₹1,00,000")
  aboutStatVenue    String @default("MAHARAJA INSTITUTE OF TECHNOLOGY THANDAVAPURA")

  // Footer
  footerText     String @default("SEE YOU AT THE EVENT HORIZON.")
  collegeName    String @default("MAHARAJA INSTITUTE OF TECHNOLOGY THANDAVAPURA")
  collegeLogoUrl String @default("")
  contactEmail   String @default("hodcse@mitt.edu.in")

  // Payment
  upiId    String @default("hackmitten@upi")
  upiQrUrl String @default("")

  // Winners
  winnersVisible    Boolean @default(false)
  winnersHeading    String  @default("THE MISSION IS COMPLETE.")
  winnersSubheading String  @default("MEET THE WINNERS.")

  // Social links (JSON-encoded)
  socialLinks String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// HACKATHON PHASES — configurable timeline
// ─────────────────────────────────────────────────────────────────────────────

model HackathonPhase {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   String // ISO date
  startTime   String // HH:mm
  endDate     String?
  endTime     String?
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@index([visible])
}

// ─────────────────────────────────────────────────────────────────────────────
// REGISTRATION DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Team {
  id             String             @id @default(cuid())
  teamName       String             @unique
  registrationId String?            @unique
  status         RegistrationStatus @default(DRAFT)
  college        String?
  registrationAcknowledgementAttemptedAt DateTime?
  registrationAcknowledgementSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  members   Participant[]
  payment   Payment?
  auditLogs AuditLog[]

  @@index([status])
  @@index([college])
  @@index([registrationId])
}

model Participant {
  id            String   @id @default(cuid())
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName      String
  email         String
  phone         String
  college       String
  degree        String?
  participantImagePath String?
  participantImageMimeType String?
  participantImageSizeBytes Int?
  isLeader      Boolean  @default(false)
  // Generated only after team approval
  participantId String?  @unique
  qrToken       String?  @unique
  passVerified  Boolean  @default(false)
  createdAt     DateTime @default(now())

  foodCheckIns FoodCheckIn[]

  @@index([teamId])
  @@index([email])
  @@index([phone])
  @@index([qrToken])
  @@index([isLeader])
}

model Payment {
  id              String        @id @default(cuid())
  teamId          String        @unique
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transactionId   String?
  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  verifiedById    String?
  verifiedBy      User?         @relation(fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  screenshots PaymentScreenshot[]

  @@index([status])
  @@index([transactionId])
}

model PaymentScreenshot {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  filePath  String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FOOD CHECK-IN
// ─────────────────────────────────────────────────────────────────────────────

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
  CUSTOM
}

model Meal {
  id        String   @id @default(cuid())
  type      MealType @default(CUSTOM)
  label     String   @default("Lunch")
  date      String? // ISO date (specific day this meal is served)
  startTime String   @default("12:00")
  endTime   String   @default("14:00")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns FoodCheckIn[]
}

model FoodCheckIn {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  mealId        String
  meal          Meal        @relation(fields: [mealId], references: [id])
  checkedInById String
  checkedInBy   User        @relation(fields: [checkedInById], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([participantId, mealId])
  @@index([mealId, createdAt])
  @@index([participantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// COORDINATORS, GALLERY, SPONSORS, WINNERS
// ─────────────────────────────────────────────────────────────────────────────

enum CoordinatorType {
  STUDENT
  FACULTY
}

model CoordinatorProfile {
  id          String          @id @default(cuid())
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id])
  name        String
  role        String
  department  String?
  type        CoordinatorType @default(STUDENT)
  phone       String?
  email       String?
  photoUrl    String?
  linkedinUrl String?
  githubUrl   String?
  isLead      Boolean         @default(false)
  sortOrder   Int             @default(0)
  visible     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type])
  @@index([visible])
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  caption   String?
  imageUrl  String
  year      String   @default("2024")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([sortOrder])
  @@index([visible])
}

enum SponsorTier {
  TITLE
  PLATINUM
  GOLD
  SILVER
  PARTNER
  CUSTOM
}

model Sponsor {
  id         String      @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String?
  tier       SponsorTier @default(PARTNER)
  customTier String?
  sortOrder  Int         @default(0)
  visible    Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([tier])
  @@index([visible])
  @@index([sortOrder])
}

model Winner {
  id            String   @id @default(cuid())
  position      Int // 1, 2, 3, ... (0 = special mention)
  positionLabel String   @default("1st Place") // "1st Place", "Special Mention", etc.
  teamName      String
  prize         String?
  description   String?
  imageUrl      String?
  sortOrder     Int      @default(0)
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([position])
  @@index([visible])
  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([teamId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHANGE HISTORY (for rollback)
// ─────────────────────────────────────────────────────────────────────────────

enum ChangeHistorySection {
  EVENT_CONFIG
  HERO
  ABOUT
  PHASE
  GALLERY
  SPONSOR
  COORDINATOR
  WINNER
  MEAL
  TEAM
  PAYMENT
  FOOD_CHECKIN
}

model ChangeHistory {
  id             String               @id @default(cuid())
  section        ChangeHistorySection
  entityId       String // ID of the affected row (or "singleton" for EventConfig)
  entityType     String // e.g. "EventConfig", "Sponsor", "Phase"
  action         String // e.g. "UPDATE", "DELETE", "APPROVE", "REJECT"
  previousState  String // JSON-encoded previous state (null for CREATE)
  newState       String // JSON-encoded new state (null for DELETE)
  changedById    String?
  changedBy      User?                @relation("ChangeHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  rolledBack     Boolean              @default(false)
  rolledBackById String?
  rolledBackBy   User?                @relation("ChangeHistoryRolledBackBy", fields: [rolledBackById], references: [id], onDelete: SetNull)
  rolledBackAt   DateTime?
  createdAt      DateTime             @default(now())

  @@index([section])
  @@index([entityId])
  @@index([changedById])
  @@index([createdAt])
  @@index([rolledBack])
}

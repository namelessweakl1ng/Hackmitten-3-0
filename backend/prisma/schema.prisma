// Hackmitten 3.0 — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & ROLES
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  COORDINATOR
  FOOD_ADMIN
  PARTICIPANT
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(PARTICIPANT)
  // BERSERK recovery hash (argon2/bcrypt of the recovery secret). NULL for non-super-admins.
  recoveryHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  foodCheckIns     FoodCheckIn[]
  verifiedPayments Payment[]

  @@index([role])
  @@index([username])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT CONFIGURATION — registration controls only
// ─────────────────────────────────────────────────────────────────────────────

model EventConfig {
  id                  String   @id @default("singleton")
  registrationEnabled Boolean  @default(true)
  registrationLimit   Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String
  websiteUrl  String?
  tier        String   @default("PARTNER")
  customTier  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// REGISTRATION DOMAIN
// ─────────────────────────────────────────────────────────────────────────────

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Team {
  id                                      String             @id @default(cuid())
  teamName                                String             @unique
  registrationId                          String?            @unique
  registrationAccessTokenHash             String?            @unique
  registrationAccessExpiresAt             DateTime?
  status                                  RegistrationStatus @default(DRAFT)
  college                                 String?
  registrationAcknowledgementAttemptedAt  DateTime?
  registrationAcknowledgementAttemptCount Int                @default(0)
  registrationAcknowledgementSentAt       DateTime?
  approvalEmailSentAt                     DateTime?
  rejectionEmailSentAt                    DateTime?
  createdAt                               DateTime           @default(now())
  updatedAt                               DateTime           @updatedAt

  members Participant[]
  payment Payment?

  @@index([status])
  @@index([college])
  @@index([registrationId])
}

model Participant {
  id                        String   @id @default(cuid())
  teamId                    String
  team                      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName                  String
  email                     String
  phone                     String
  college                   String
  degree                    String?
  participantImagePath      String?
  participantImageMimeType  String?
  participantImageSizeBytes Int?
  isLeader                  Boolean  @default(false)
  // Generated only after team approval
  participantId             String?  @unique
  qrToken                   String?  @unique
  passVerified              Boolean  @default(false)
  createdAt                 DateTime @default(now())

  foodCheckIns FoodCheckIn[]

  @@index([teamId])
  @@index([email])
  @@index([phone])
  @@index([qrToken])
  @@index([isLeader])
}

model Payment {
  id              String        @id @default(cuid())
  teamId          String        @unique
  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transactionId   String?
  status          PaymentStatus @default(PENDING)
  rejectionReason String?
  verifiedById    String?
  verifiedBy      User?         @relation(fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  screenshots PaymentScreenshot[]

  @@index([status])
  @@index([transactionId])
}

model PaymentScreenshot {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  filePath  String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FOOD CHECK-IN
// ─────────────────────────────────────────────────────────────────────────────

enum MealType {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
  CUSTOM
}

model Meal {
  id        String   @id @default(cuid())
  type      MealType @default(CUSTOM)
  label     String   @default("Lunch")
  date      String? // ISO date (specific day this meal is served)
  startTime String   @default("12:00")
  endTime   String   @default("14:00")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkIns FoodCheckIn[]
}

model FoodCheckIn {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  mealId        String
  meal          Meal        @relation(fields: [mealId], references: [id])
  checkedInById String
  checkedInBy   User        @relation(fields: [checkedInById], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([participantId, mealId])
  @@index([mealId, createdAt])
  @@index([participantId])
}

// ─────────────────────────────────────────────────────────────────────────────
